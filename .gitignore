/bin/
vault/.brain/
.DS_Store
*.db
*.db-wal
*.db-shm
node_modules/
dist/
# Exception: the Wails app frontend under app/frontend/dist is hand-authored
# source embedded into the binary (frontend:build is empty — it is not generated),
# so it must be tracked despite the generic dist/ rule above.
!app/frontend/dist/
!app/frontend/dist/**
build/bin/
app/build/bin/
# Wails regenerates these TypeScript bindings on every build; the frontend is
# vanilla JS and calls window.go.* directly, so they are not used at runtime.
app/frontend/wailsjs/
app/vault/
vault/recordings/
vault/sources/
vault/.brain/scratch/
vault/business/

# Bundled voice engines (fetched at build time via scripts/fetch-voice.sh)
resources/voice/whisper/*
resources/voice/piper/*
!resources/voice/whisper/.gitkeep
!resources/voice/piper/.gitkeep
!resources/voice/README.md

# Regenerable icon review strip (scripts/make-icon.py --preview)
app/build/appicon-preview.png

# benchmark adapter virtualenvs — recreate with bench/README.md
bench/adapters/.venv-*

# Letta writes its OpenAPI spec into the working directory on server start.
bench/adapters/openapi_letta.json

# Personal notes: product comparisons, ideas, strategy. Never committed.
personal/

# Working notes and drafts. Same rule as personal/ — thinking, not product.
# The space is literal; gitignore takes no quoting.
yap files/

# npm platform packages are generated from dist/ by npm/scripts/build.js — they
# hold ~11MB binaries each and are rebuilt for every release.
npm/platforms/
npm/node_modules/
# Exception: npm/bin holds the hand-written launcher, not a build product. The
# generic bin/ rule at the top of this file would otherwise swallow the one file
# the npm package cannot work without.
!npm/bin/
!npm/bin/**

# Benchmark output — regenerable, and large.
bench/results/

# Python bytecode from the benchmark adapters.
__pycache__/

# Agent worktrees and local session state. Never committed: a worktree is a
# second checkout of this repo, and committing one nests the repo inside itself.
.claude/

# Local agent working notes. AGENTS.md and CONTRIBUTING.md are the committed
# instructions every agent reads; CLAUDE.md is one person's layer on top and
# does not belong in everyone's checkout.
CLAUDE.md
