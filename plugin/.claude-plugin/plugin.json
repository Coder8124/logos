{
  "$schema": "https://code.claude.com/schemas/plugin.json",
  "name": "logos",
  "displayName": "Logos — continuity across agents",
  "description": "Checkpoint and resume work across Claude Code, Cursor and Codex. Records what was ruled out so the next agent does not repeat it. Local-first: your memory is markdown on your disk.",
  "version": "0.1.0",
  "author": {
    "name": "Coder8124",
    "url": "https://github.com/Coder8124"
  },
  "homepage": "https://github.com/Coder8124/logos",
  "repository": "https://github.com/Coder8124/logos",
  "license": "MIT",
  "keywords": ["memory", "continuity", "handoff", "mcp", "local-first"],
  "category": "productivity",
  "skills": ["./skills/"],
  "commands": ["./commands/"],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "logos": {
      "command": "npx",
      "args": ["-y", "@noeton/logos", "mcp", "serve"]
    }
  }
}
